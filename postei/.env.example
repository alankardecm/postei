# Servidor HTTP
PORT=4710

# Segredo compartilhado entre o painel e o motor
POSTEI_API_KEY=

# Gateway LiteLLM
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=
MODELO_TEXTO=postei-texto-lite
MODELO_PESADO=postei-texto
CASCATA_TEXTO=postei-texto-lite,postei-texto
LLM_TIMEOUT_MS=90000
LLM_TIMEOUT_IMAGEM_MS=120000

# Imagine (xAI) — só anúncio da marca Postei. Sem isso, cai no template.
# Chave em https://console.x.ai  ·  modelo barato: grok-imagine-image (US$ 0,02)
XAI_API_KEY=
XAI_MODELO_IMAGEM=grok-imagine-image

# Banco de imagens
PEXELS_API_KEY=

# Geracao
DIR_SAIDA=./saida
MAX_POSTS_LOTE=30
INTERVALO_BLOCO_MS=3500
